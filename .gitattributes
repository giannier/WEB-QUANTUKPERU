# Normaliza los finales de línea: LF en el repositorio, nativos al descargar.
# Sin esto, un cambio de una línea hecho desde Windows aparece como el archivo
# entero modificado cuando alguien lo abre desde Mac o Linux.
* text=auto eol=lf

# Binarios: que Git no intente convertirlos ni mostrar diferencias de texto
*.png  binary
*.webp binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.woff binary
*.woff2 binary
