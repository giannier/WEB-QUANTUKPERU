# --- Configuración local de herramientas -----------------------------------
# Contiene rutas absolutas y permisos de esta máquina: no sirve en otra
# y expone la estructura del equipo.
.claude/

# Índice de skills generado localmente
.atl/

# --- Archivos temporales del proceso de build ------------------------------
# Páginas y scripts auxiliares que se crean y borran al generar o auditar
__*.html
__*.js

# --- Sistema operativo ------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# --- Editores ---------------------------------------------------------------
*.code-workspace
*.swp
*~

# --- Varios -----------------------------------------------------------------
*.log
*.tmp
node_modules/

# --- Python ----------------------------------------------------------------
# Bytecode que genera el intérprete al importar preview.py
__pycache__/
*.py[cod]

# --- Libro de Reclamaciones -------------------------------------------------
# Credenciales del correo: jamás deben entrar al historial de Git
api/config.secret.php

# Hojas de Reclamación archivadas: contienen datos personales de los
# reclamantes (nombre, DNI, domicilio, teléfono). Se conservan en el
# servidor durante dos años, no en el repositorio.
api/storage/hojas/**
!api/storage/hojas/.gitignore
api/storage/log/**
!api/storage/log/.gitignore
api/storage/ratelimit/**
!api/storage/ratelimit/.gitignore
api/storage/correlativo.dat
